# Read about configuration, here:
# https://craftcms.com/docs/5.x/configure.html

# The application ID used to to uniquely store session and cache data, mutex locks, and more
CRAFT_APP_ID=

# The environment Craft is currently running in (dev, staging, production, etc.)
CRAFT_ENVIRONMENT=dev

# Email
SYSTEM_EMAIL_ADDRESS=craft@viget.com
SYSTEM_EMAIL_SENDER="Craft CMS"
SYSTEM_EMAIL_HOSTNAME=
SYSTEM_EMAIL_PORT=
SYSTEM_EMAIL_USERNAME=
SYSTEM_EMAIL_PASSWORD=

# General settings
CRAFT_SECURITY_KEY=
CRAFT_DEV_MODE=true
CRAFT_ALLOW_ADMIN_CHANGES=true
CRAFT_DISALLOW_ROBOTS=true

# Amazon S3
S3_BASE_URL=
S3_SUBFOLDER=
S3_BUCKET_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_CLOUDFRONT_DISTRIBUTION_ID=

# AWS Serverless
IMAGERX_SERVERLESS_DISTRIBUTION_URL=
IMAGERX_SERVERLESS_DISTRIBUTION_SIGNATURE=
