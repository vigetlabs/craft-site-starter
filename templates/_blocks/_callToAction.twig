{# @var \craft\elements\Entry|null block #}
{% from '_components/call-to-action' import CallToAction %}

{% set block = block ?? null %}

{# @var int headingLevel #}
{% set headingLevel = headingLevel ?? 2 %}

{{ CallToAction({
  title: block.title,
  text: block.richTextSimple,
  href: block.button.value,
  buttonText: block.button.label ?? null,
  newTab: block.button.target ?? null,
  headingLevel,
}) }}
