{# @var \craft\elements\Entry block #}
{% from '_components/card-image' import CardImage %}
{% from '_components/card-icon' import CardIcon %}
{% from '_components/heading-tag' import HeadingTag %}

{% set block = block ?? null %}

{# @var int headingLevel #}
{% set headingLevel = headingLevel ?? 2 %}

{% set cardHeadingLevel = block.heading is not empty ? headingLevel + 1 : headingLevel %}

<div class="container">
  {% if block.heading %}
    {% tag HeadingTag(headingLevel) with {
      class: 'text-3xl font-bold mb-48',
    } %}
      {{ block.heading }}
    {% endtag %}
  {% endif %}
  <div class="grid gap-24 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 lg:gap-48">
    {% for card in block.cardGrid.eagerly().collect() %}
      {% switch card.type.handle %}
        {% case 'imageCard' %}
          {{ CardImage({
            image: card.image.eagerly().one(),
            sizes: {
              default: '100vw',
              sm: '50vw',
              md: '33vw',
              lg: '25vw',
            },
            href: card.basicLink,
            newTab: card.basicLink.target ?? null,
            title: card.title,
            description: card.description,
            headingLevel: cardHeadingLevel,
          }) }}
        {% case 'iconCard' %}
          {{ CardIcon({
            href: card.basicLink,
            newTab: card.basicLink.target ?? null,
            icon: card.icon.value,
            title: card.title,
            description: card.description,
            headingLevel: cardHeadingLevel,
          }) }}
      {% endswitch %}
    {% endfor %}
  </div>
</div>
