{# @var \craft\elements\Entry|null block #}
{% from '_components/heading-tag' import HeadingTag %}

{% set block = block ?? null %}

{# @var int headingLevel #}
{% set headingLevel = headingLevel ?? 1 %}

{% tag HeadingTag(headingLevel) with {
  class: cx('container font-bold', {
    'text-4xl': headingLevel == 1,
    'text-3xl': headingLevel != 1,
  }),
} %}
  {{ block.heading }}
{% endtag %}
