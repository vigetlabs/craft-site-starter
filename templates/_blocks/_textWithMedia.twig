{% from '_components/image' import Image %}

{# @var \craft\elements\Entry block #}
{% set block = block ?? null %}

{% set textContent %}
  <div>
    {% if block.heading %}
      <h2 class="text-2xl font-bold mb-32">{{ block.heading }}</h2>
    {% endif %}

    {% if block.richText %}
      <div class="rich-text">
        {{ block.richText }}
      </div>
    {% endif %}
  </div>
{% endset %}

{% set mediaContent %}
  <div>
    {% switch block.mediaType %}
      {% case 'image' %}
        {{ Image({
          image: block.image.eagerly().one(),
          sizes: {
            default: '100vw',
            sm: '50vw',
          },
        }) }}
      {% case 'video' %}
        {{ include('_components/video.twig', {
          source: block.videoUrl,
        }) }}
    {% endswitch %}
  </div>
{% endset %}

<div class="container grid gap-24 sm:grid-cols-2 lg:gap-48">
  {# Resolves any tab ordering issues #}
  {% switch block.side %}
    {% case 'left' %}
      {{ mediaContent }}
      {{ textContent }}
    {% case 'right' %}
      {{ textContent }}
      {{ mediaContent }}
  {% endswitch %}
</div>
