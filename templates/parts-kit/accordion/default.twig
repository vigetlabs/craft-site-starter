{% from '_components/accordion' import Accordion %}

<div>
  {% for i in 1..3 %}
    {{
      Accordion({
        title: 'Accordion Item ' ~ i,
        content: 'This is the content for accordion item ' ~ i ~ '.'
      })
    }}
  {% endfor %}
</div>

<h2 class="mt-40 mb-16 text-2xl font-bold">Grouped Accordions</h2>

<div>
  {% for i in 1..3 %}
    {{
      Accordion({
        title: 'Accordion Item ' ~ i,
        content: 'This is the content for accordion item ' ~ i ~ '.',
        name: 'accordion-group'
      })
    }}
  {% endfor %}
</div>
