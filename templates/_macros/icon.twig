{#
Inlines the SVG markup directly into the page.

Provides icon size props so you don't have to remember to pass
`.size-xyz` every time you want to use your icon system.

By setting size to `none` you can add arbitrary sizes to the icon.
#}
{% macro icon(props = {}) %}
  {% set props = props | merge({
    name: props.name ?? null,
    size: props.size ?? 'md',
    class: props.class ?? null,
  }) %}

  {% set sizeConfig = {
    'sm': 'size-16',
    'md': 'size-24',
    'lg': 'size-32',
    'none': null,
  } %}

  {% set sizeClass = sizeConfig[props.size] ?? sizeConfig.md %}

  {{ svg('@webroot/dist/assets/icons/' ~ props.name ~ '.svg') | attr({
    class: cx(sizeClass, props.class),
  }) }}
{% endmacro %}
