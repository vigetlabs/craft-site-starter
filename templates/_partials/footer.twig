{% from "_components/icon.twig" import Icon %}

{% set footerNavigation = craft.navigation.nodes()
    .handle('footerNavigation')
    .level(1)
    .with(['children'])
    .collect() %}

<footer id="footer" class="bg-gray-800 text-gray-100 py-32 md:py-64">
  <div class="container">
    {# Logo and nav lockup #}
    <div class="grid md:grid-cols-5 gap-32">
      <div class="col-span-1 lg:col-span-2">
        <a class="hover:text-amber-600 transition-colors duration-300 inline-block" href="{{ url('/') }}">
          {{ Icon({
            name: 'logo-mark',
            size: 'sm',
          }) }}

          <span class="sr-only">{{ currentSite.name }} - Home</span>
        </a>
      </div>

      <nav class="md:col-span-4 lg:col-span-3" aria-label="Footer Navigation">
        <ul class="grid grid-cols-2 md:grid-cols-4 gap-32">
          {% for node in footerNavigation %}
            {% set children = node.children %}
            {% set element = node.url ? 'a' : 'span' %}
            <li class="grid gap-16">
              {% tag element with {
                href: node.url,
                class: cx('text-gray-200 font-semibold text-sm uppercase tracking-widest', {
                  'hover:text-white hover:underline': node.url,
                }),
              } %}
                {{ node.title }}
              {% endtag %}

              {% if children.count() %}
                <ul class="grid gap-8">
                  {% for child in children %}
                    {% set childElement = child.url ? 'a' : 'span' %}
                    <li>
                      {% tag childElement with {
                        href: child.url,
                        class: cx('text-gray-400 text-sm font-semibold text-lg', {
                          'hover:text-white hover:underline': child.url,
                        }),
                      } %}
                        {{ child.title }}
                      {% endtag %}
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </nav>
    </div>

    {# Copyright and privacy policy #}
    <div class="border-t border-white/10 pt-32 mt-32 grid grid-cols-1 max-md:text-center md:grid-cols-[1fr_auto] text-sm gap-16 md:gap-0">
      <p class="text-gray-400">
        &copy; {{ now|date('Y') }} {{ currentSite.name }}. All rights reserved.
      </p>

      <a class="text-gray-400 hover:text-white hover:underline" href="#TODO">Privacy Policy</a>
    </div>
  </div>
</footer>
