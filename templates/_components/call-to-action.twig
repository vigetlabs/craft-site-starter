{# @var string|null title #}
{% set title = title ?? null %}

{# @var string|null text #}
{% set text = text ?? null %}

{# @var string|null href #}
{% set href = href ?? null %}

{# @var string|null buttonText #}
{% set buttonText = buttonText ?? null %}

{# @var boolean|null newTab #}
{% set newTab = newTab ?? null %}

<div class="bg-gray-200 py-48">
  <div class="container flex flex-col items-center gap-24">
    {% if title %}
      <h2 class="text-xl font-semibold">{{ title }}</h2>
    {% endif %}

    {% if text %}
      <div class="max-w-[640px]">{{ text }}</div>
    {% endif %}

    {% if href and buttonText %}
      {{ include('_components/button.twig', {
        href,
        newTab,
        text: buttonText,
      }) }}
    {% endif %}
  </div>
</div>
