{% macro FieldSelect(props = {}) %}
  {% from '_components/field-group' import FieldGroup %}

  {# Props #}

  {# These props mirror the props in field-group.twig #}

  {# @var id string #}
  {% set id = props.id ?? null %}

  {# @var class string|null #}
  {% set class = props.class ?? null %}

  {# @var fieldAttrs array #}
  {% set fieldAttrs = props.fieldAttrs ?? {} %}

  {# @var label string|null #}
  {% set label = props.label ?? null %}

  {# @var labelHidden bool #}
  {% set labelHidden = props.labelHidden ?? false %}

  {# @var required bool #}
  {% set required = props.required ?? false %}

  {# @var subLabel string|null #}
  {% set subLabel = props.subLabel ?? null %}

  {# @var instructions string|null #}
  {% set instructions = props.instructions ?? null %}

  {# @var errorMessages string[] #}
  {% set errorMessages = props.errorMessages ?? [] %}

  {# These props are for the select element #}

  {# @var name string|null #}
  {% set name = props.name ?? null %}

  {# @var placeholder string|null Only used when a blank option is present #}
  {% set placeholder = props.placeholder ?? null %}

  {# @var useEmptyOption bool #}
  {% set useEmptyOption = props.useEmptyOption ?? false %}

  {# @var disabled bool #}
  {% set disabled = props.disabled ?? false %}

  {# @var options array{label: string, value: string, selected: bool}[] #}
  {% set options = props.options ?? [] %}

  {% macro option(item) %}
    <option {{ attr({
      value: item.value ?? '',
      selected: item.selected is defined ? '' : null,
    }) }}>
      {{ item.label }}
    </option>
  {% endmacro %}

  {% if useEmptyOption %}
    {% set options = options|unshift({label: placeholder, value: '' }) %}
  {% endif %}

  {{ FieldGroup({
    fieldElement: 'select',
    fieldAttrs: {
      ...fieldAttrs,
      name,
      disabled: disabled ? '' : null,
    },
    id,
    class,
    fieldChildren: options|map(item => _self.option(item)),
    label,
    labelHidden,
    required,
    subLabel,
    instructions,
    errorMessages,
  }) }}
{% endmacro %}
