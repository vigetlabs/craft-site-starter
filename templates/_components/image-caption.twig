{% macro ImageCaption(props = {}) %}
  {% from '_components/image' import Image %}

  {# Props #}

  {#
    @var array imageProps

    Use the same props that are defined in the image component.

    Example:

    {{ include('_components/image-caption.twig', {
      imageProps: {
        image: craft.assets().filename('image.jpg').one(),
        class: 'my-custom-class',
        ratio: 1/1,
        sizes: {
          default: '100vw',
          sm: '50vw',
          md: '33vw',
        },
      },
      caption: 'Image caption',
    }) }}
  #}
  {% set imageProps = props.imageProps ?? {} %}

  {# @var string|null caption #}
  {% set caption = props.caption ?? null %}

  {# @var string|null class #}
  {% set class = props.class ?? null %}

  <figure class="{{ class }}">
    {{ Image(imageProps) }}
    {% if caption %}
      <figcaption>{{ caption }}</figcaption>
    {% endif %}
  </figure>
{% endmacro %}
