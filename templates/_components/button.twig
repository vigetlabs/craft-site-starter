{% macro Button(props = {}) %}
  {% from '_components/icon.twig' import Icon %}
  {# Props #}

  {# @var string|null as #}
  {% set as = props.as ?? null %}

  {# @var string variant #}
  {% set variant = props.variant ?? 'contained' %}

  {# @var string size #}
  {% set size = props.size ?? 'md' %}

  {# @var string|null title #}
  {% set title = props.title ?? null %}

  {# @var string|null icon The name of the icon to use #}
  {% set icon = props.icon ?? null %}

  {# @var bool iconLast #}
  {% set iconLast = props.iconLast ?? false %}

  {# @var bool iconOnly #}
  {% set iconOnly = props.iconOnly ?? false %}

  {# @var string|null href #}
  {% set href = props.href ?? null %}

  {# @var bool newTab #}
  {% set newTab = props.newTab ?? false %}

  {# @var string type #}
  {% set type = props.type ?? 'button' %}

  {# @var bool disabled #}
  {% set disabled = props.disabled ?? false %}

  {# @var string|null class #}
  {% set class = props.class ?? null %}

  {# @var string|null text #}
  {% set text = props.text ?? null %}

  {# Determine element type #}
  {% set el = as ?? (href and not disabled ? 'a' : 'button') %}

  {# @var array attrs #}
  {% set attrs = props.attrs ?? {} %}

  {% tag el with attrs | merge({
    href: not disabled ? href : null,
    target: newTab ? '_blank' : null,
    rel: newTab ? 'noopener' : null,
    disabled: disabled ? true : null,
    type: el == 'button' ? type : null,
    title: title,
    class: cx({
      'btn-contained': variant == 'contained',
      'btn-outlined': variant == 'outlined',
      'btn-subtle': variant == 'subtle',
      'btn-text': variant == 'text',
      'btn-icon': iconOnly,
      'btn-sm': size == 'sm',
      'btn-lg': size == 'lg',
    }, class),
  }) %}
    {{ icon ? Icon({
      name: icon,
      size: size,
      class: iconLast ? 'order-last' : null,
    }) }}

    {{ text }}
  {% endtag %}
{% endmacro %}
