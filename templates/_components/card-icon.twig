{% macro CardIcon(props = {}) %}
  {% from '_components/icon.twig' import Icon %}

  {# Props #}

  {# @var string|null class #}
  {% set class = props.class ?? null %}

  {# @var string|null url #}
  {% set url = props.url ?? null %}

  {# @var string|null target Pass '_blank' to open in a new tab. #}
  {% set target = props.target ?? null %}

  {# @var string align #}
  {% set align = props.align ?? 'left' %}

  {# @var string|null icon #}
  {% set icon = props.icon ?? null %}

  {# @var int headingLevel #}
  {% set headingLevel = props.headingLevel ?? 3 %}

  {# @var string|null title #}
  {% set title = props.title ?? null %}

  {# @var string|null description #}
  {% set description = props.description ?? null %}

  {# Computed values #}
  {% set element = url ? 'a' : 'article' %}
  {% set headingElement = "h#{headingLevel}" %}

  {% tag element with {
    class: cx(class, 'flex flex-col gap-24', {
      'items-start': align == 'left',
      'items-center text-center': align == 'center',
    }),
    href: url,
    target: target,
    rel: target == '_blank' ? 'noopener noreferrer' : null,
  } %}
    {% if icon %}
      <div class="flex size-48 items-center justify-center rounded-full bg-sky-200 text-black">
        {{ Icon({
          name: icon,
        }) }}
      </div>
    {% endif %}

    {% if title or description %}
      <div class="flex flex-col gap-8">
        {% if title %}
          {% tag headingElement with {
            class: 'text-xl font-bold',
          } %}
            {{ title }}
          {% endtag %}
        {% endif %}
        {% if description %}
          <p class="text-sm">{{ description }}</p>
        {% endif %}
      </div>
    {% endif %}
  {% endtag %}
{% endmacro %}
