{% macro FieldTextInput(props = {}) %}
  {% from '_components/field-group' import FieldGroup %}

  {# Props #}

  {# These props mirror the props in field-group.twig #}

  {# @var string|null id #}
  {% set id = props.id ?? null %}

  {# @var string|null class #}
  {% set class = props.class ?? null %}

  {# @var array fieldAttrs #}
  {% set fieldAttrs = props.fieldAttrs ?? {} %}

  {# @var string|null label #}
  {% set label = props.label ?? null %}

  {# @var bool labelHidden #}
  {% set labelHidden = props.labelHidden ?? false %}

  {# @var bool required #}
  {% set required = props.required ?? false %}

  {# @var string|null subLabel #}
  {% set subLabel = props.subLabel ?? null %}

  {# @var string|null instructions #}
  {% set instructions = props.instructions ?? null %}

  {# @var string[] errorMessages #}
  {% set errorMessages = props.errorMessages ?? [] %}

  {# These props are for the input element #}

  {# @var string|null name #}
  {% set name = props.name ?? null %}

  {# @var string|null placeholder #}
  {% set placeholder = props.placeholder ?? null %}

  {# @var bool disabled #}
  {% set disabled = props.disabled ?? false %}

  {# @var string|null type #}
  {% set type = props.type ?? 'text' %}

  {# Allowed types #}
  {% set allowedTypes = ['text', 'password', 'email', 'number', 'tel', 'url'] %}
  {% set validatedType = type in allowedTypes ? type : 'text' %}

  {{ FieldGroup({
    fieldElement: 'input',
    fieldAttrs: {
      ...fieldAttrs,
      name,
      type: validatedType,
      placeholder,
      disabled: disabled ? '' : null,
    },
    id,
    class,
    label,
    labelHidden,
    required,
    subLabel,
    instructions,
    errorMessages,
  }) }}
{% endmacro %}
