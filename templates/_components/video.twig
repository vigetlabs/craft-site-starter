{#
  TODO possible improvements
  - rework to parse the video provider & id from any type of URL.
  - customizable thumbnail / play button
#}

{% macro Video(props = {}) %}
  {% from '_components/button' import Button %}

  {# Props #}

  {#
    @var string source - The source of the video. E.g. 'https://www.youtube.com/embed/lJIrF4YjHfQ'
  #}
  {% set source = props.source ?? '' %}

  {#
    @var array iframeAttrs - Additional attributes to pass to the iframe element.
  #}
  {% set iframeAttrs = props.iframeAttrs ?? {} %}

  {#
    @var string|null class - Additional classes for the wrapper div
  #}
  {% set class = props.class ?? null %}

  {# Computed values #}

  {# Generate a unique ID for the video element #}
  {% set id = 'video-' ~ random() %}

  <div class="{{ classNames('relative', class) }}">
    {{ Button({
      href: '#' ~ id,
      variant: 'text',
      class: 'sr-only focus-visible:not-sr-only',
      text: 'Skip past video'
    }) }}

    <iframe
      src="{{ source }}"
      class="aspect-video size-full"
      allow="autoplay; fullscreen; picture-in-picture"
      allowfullscreen="true"
      loading="lazy"
      {{ attr(iframeAttrs) }}
    ></iframe>
  </div>

  <div id="{{ id }}"></div>
{% endmacro %}
