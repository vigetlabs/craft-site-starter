{% from '_macros/icon.twig' import icon %}

{# @var string|null class #}
{% set class = class ?? null %}

{# @var string|null href #}
{% set href = href ?? null %}

{# @var bool newWindow #}
{% set newWindow = newWindow ?? false %}

{# @var craft\elements\Asset|null image #}
{% set image = image ?? null %}

{# @var float|null ratio #}
{% set ratio = ratio ?? null %}

{# @var array|null sizes #}
{% set sizes = sizes ?? null %}

{# @var string align #}
{% set align = align ?? 'left' %}

{# @var int headingLevel #}
{% set headingLevel = headingLevel ?? 3 %}

{# @var string|null title #}
{% set title = title ?? null %}

{# @var string|null description #}
{% set description = description ?? null %}

{# Computed values #}
{% set element = href ? 'a' : 'article' %}
{% set headingElement = "h#{headingLevel}" %}

{% tag element with {
  class: cx(class, 'flex flex-col gap-24', {
    'items-start': align == 'left',
    'items-center text-center': align == 'center',
  }),
  href: href,
  target: href and newWindow ? '_blank' : null,
} %}
  {% if image %}
    {{ include('_components/image.twig', {
      image: image,
      sizes: sizes,
      ratio: ratio,
    }) }}
  {% endif %}

  {% if title or description %}
    <div class="flex flex-col gap-8">
      {% if title %}
        {% tag headingElement with {
          class: 'text-xl font-bold',
        } %}
          {{ title }}
        {% endtag %}
      {% endif %}
      {% if description %}
        <p class="text-sm">{{ description }}</p>
      {% endif %}
    </div>
  {% endif %}
{% endtag %}
