{% macro CardImage(props = {}) %}
  {% from '_macros/icon.twig' import icon %}
  {% from '_components/image' import Image %}

  {# Props #}

  {# @var string|null class #}
  {% set class = props.class ?? null %}

  {# @var string|null href #}
  {% set href = props.href ?? null %}

  {# @var bool newTab #}
  {% set newTab = props.newTab ?? false %}

  {# @var craft\elements\Asset|null image #}
  {% set image = props.image ?? null %}

  {# @var float|null ratio #}
  {% set ratio = props.ratio ?? null %}

  {# @var array|null sizes #}
  {% set sizes = props.sizes ?? null %}

  {# @var string align #}
  {% set align = props.align ?? 'left' %}

  {# @var int headingLevel #}
  {% set headingLevel = props.headingLevel ?? 3 %}

  {# @var string|null title #}
  {% set title = props.title ?? null %}

  {# @var string|null description #}
  {% set description = props.description ?? null %}

  {# Computed values #}
  {% set element = href ? 'a' : 'article' %}
  {% set headingElement = "h#{headingLevel}" %}

  {% tag element with {
    class: cx(class, 'flex flex-col gap-24', {
      'items-start': align == 'left',
      'items-center text-center': align == 'center',
    }),
    href: href,
    target: href and newTab ? '_blank' : null,
  } %}
    {% if image %}
      {{ Image({
        image: image,
        sizes: sizes,
        ratio: ratio,
      }) }}
    {% endif %}

    {% if title or description %}
      <div class="flex flex-col gap-8">
        {% if title %}
          {% tag headingElement with {
            class: 'text-xl font-bold',
          } %}
            {{ title }}
          {% endtag %}
        {% endif %}
        {% if description %}
          <p class="text-sm">{{ description }}</p>
        {% endif %}
      </div>
    {% endif %}
  {% endtag %}
{% endmacro %}
